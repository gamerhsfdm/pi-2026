# Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores.
# O arquivo .env é carregado automaticamente por config/database.php e NUNCA deve ser publicado.

# --- Banco de dados (XAMPP local) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projeto_tunisia
DB_USER=root
DB_PASS=

# --- Ambiente ---
# development: mostra erros na tela (use só no computador local)
# production: esconde erros e grava apenas em log (padrão se a variável não existir)
APP_ENV=development
APP_DEBUG=true

# Caminho base do site (ex.: /ProjetoIntegrador-2026 ou vazio na raiz do domínio)
SITE_URL=/ProjetoIntegrador-2026

# URL pública completa para SEO (canonical, Open Graph e sitemap). Em produção, defina:
# PUBLIC_URL=https://www.seudominio.com.br
PUBLIC_URL=

# --- HTTPS e proxy (produção) ---
# FORCE_HTTPS=1 redireciona http -> https. Só ative com certificado instalado.
FORCE_HTTPS=0
# TRUST_PROXY=1 apenas se o site estiver atrás de proxy/CDN confiável (Cloudflare, Nginx etc.)
TRUST_PROXY=0

# --- Segurança de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Desempenho ---
# Tempo (em segundos) do cache da página pública. 0 desativa. O cache é limpo automaticamente
# sempre que alguém publica/edita conteúdo no painel.
CACHE_TTL=600

# --- E-mail (SMTP) — recuperação de senha e avisos de publicação ---
# SMTP_SECURE: tls (STARTTLS, porta 587), ssl (porta 465) ou none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Projeto Tunísia
SMTP_VERIFY_TLS=1

# --- Agendador e backups ---
# Token do gatilho HTTP /cron.php?token=... (mín. 16 caracteres; vazio = endpoint desativado).
# Só é necessário em hospedagem sem cron/terminal.
CRON_TOKEN=
# Quantos backups manter e onde guardá-los (prefira uma pasta FORA da raiz pública).
BACKUP_KEEP=7
BACKUP_DIR=
BACKUP_INCLUDE_UPLOADS=1

# --- Somente ao executar admin/create_admin.php via terminal ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
# Defina ADMIN_PASSWORD temporariamente no ambiente; nunca grave a senha real neste arquivo
